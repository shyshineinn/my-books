# Docker Compose reads .env automatically. Node itself does not: use the command documented below.
# Keep this example free of real credentials.
HOST=127.0.0.1
PORT=3000
MYBOOKS_PORT=3000
NODE_ENV=production
MYBOOKS_STORAGE_DIR=./storage
MYBOOKS_PUBLIC_URL=http://localhost:3000
MYBOOKS_PUBLIC_READ=false
MYBOOKS_SEED_DEMO=false
# Enable only for a trusted local reverse proxy:
# MYBOOKS_TRUST_PROXY=loopback
# Create the administrator with npm run setup; do not store its password here.
