# ============================================================
# calibre-server · systemd 服务单元
#
# 放置路径:/etc/systemd/system/calibre-server.service
# 启用:  sudo systemctl daemon-reload
#         sudo systemctl enable --now calibre-server
# 查看:  sudo systemctl status calibre-server
#         journalctl -u calibre-server -f
#
# ── 关键:三个参数缺一不可,否则前端接不上 ──
#
# 1) --listen-on 127.0.0.1
#    只监听本机,由 Nginx / Node 反代对外。与 my-books 的 HOST=127.0.0.1 同一思路。
#    ⚠️ 绝不要让 calibre 直接监听 0.0.0.0 —— 配合下面的 trusted-ips 就等于
#       把「删库」按钮暴露给全网。
#
# 2) --url-prefix /calibre
#    calibre 自己占着 /(它的 index() 返回自家 SPA,见 calibre srv/code.py:38),
#    所以必须挂在子路径下,把 / 让给你的前端。
#    ⚠️ Nginx 侧必须把 /calibre 301 到 /calibre/(尾斜杠),
#       否则相对路径与 Service Worker 会错位(calibre manual/server.rst:324-327)。
#
# 3) --trusted-ips
#    calibre 的写操作要求 is_trusted_ip(calibre srv/loop.py:179-181、
#    srv/handler.py:120-126)。不发 --enable-auth 时,读是公开的,
#    但写必须来自可信 IP。这里只信任本机 —— 写操作统一由 Node 转发,
#    公网用户碰不到 calibre 的写接口。
#
# ⚠️ 不要加 --enable-auth!
#    calibre 的 /ajax/* 端点 auth_required 默认为 True(calibre srv/routes.py:116),
#    一旦开启认证,连 /get/cover 封面图都要登录,公开站点直接废掉。
#    这正是为什么读走公开、写走 trusted-ips 的组合是唯一可行解。
#
# 库路径与端口(按服务器实际改):
#   /root/calibre-library   你的 calibre 库目录
#   3003                    calibre 端口(3001=ecook,3002=my-books,故用 3003)
# ============================================================

[Unit]
Description=calibre Content server (my-books 后端)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# calibre 官方二进制安装位置(安装脚本默认 /opt/calibre)
ExecStart=/opt/calibre/calibre-server \
    --listen-on 127.0.0.1 \
    --port 3003 \
    --url-prefix /calibre \
    --trusted-ips 127.0.0.1 \
    --log /var/log/calibre-server.log \
    --max-log-size 20 \
    /root/calibre-library

# 崩溃自动拉起
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=calibre-server

# 基础加固。注意不要限制文件写入 —— calibre 要往库目录与配置目录写
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
